# Local checks, manual recipes and OCR need no provider credentials.
# Optional Cloudflare AI: use your OWN account and server-side secrets.
# Never paste these values into source code, screenshots or issues.
CF_AI_ACCOUNT_ID=
CF_AI_TOKEN=
# Enable only after verifying Workers Free in your own account.
CF_AI_FREE_ONLY_CONFIRMED=false
# Optional Alpha-only owner exception: exact authenticated owner email.
# Empty means the default 2 attempts/user/UTC day; configured owner gets 20.
AI_OWNER_EMAIL=
